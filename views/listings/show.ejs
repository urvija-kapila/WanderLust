<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";  //script created in ejs file which will be accessed by the map.js files 
    //for accessing the env variable of map token. The public folder doesnt have access to the env variables, 
    // so we need to pass it from the ejs file to the map.js file.
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
        <h3 class="mb-3"><%= listing.title %></h3>
        <div class="card show-card listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>" >
            <div class="card-body mt-4">
                <p class="card-text"> Owned by <i><%= listing.owner.username %></i></p>
                <p class="card-text"> <%= listing.description %></p>
                <p class="card-text"> &#8377; <%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text"><%= listing.location %></p>
                <p class="card-text"> <%= listing.country %></p>
            </div>
        </div>

        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns mb-4">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark update-btn">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark"> Delete</button>
                </form>
            </div>
        <% } %>
       
        <% if (currUser) { %>
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label"> Rating </label>
                    <fieldset class="starability-grow">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." >
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" >
                        <label for="first-rate1" title="Terrible"> 1 star </label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" >
                        <label for="first-rate2" title="Not good"> 2 stars </label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3">
                        <label for="first-rate3" title="Average"> 3 stars </label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4">
                        <label for="first-rate4" title="Very good"> 4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" >
                        <label for="first-rate5" title="Amazing"> 5 stars </label>
                    </fieldset>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment">
                        Comments
                    </label>
                    <textarea  name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required ></textarea>
                    <div class="invalid-feedback">
                        Please provide comments for review.
                    </div>
                </div>
                <button class="btn btn-outline-dark">
                    Submit
                </button>
            </form>
        <% } %>
        
        <hr>
        <% if (listing.reviews.length === 0) { %>
            <p>No reviews yet. Be the first one to review!</p>
        <% } else { %>
            <p><b>All Reviews</b></p>
            <div class="row">
                <% for (let review of listing.reviews) { %>
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card review-card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    @<%= review.author.username %>
                                </h5>
                                <p
                                    class="starability-result card-text"
                                    data-rating="<%= review.rating %>"
                                ></p>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>
                            </div>
                            <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                <form class="mb-3 review-delete-form"
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >
                                    <button class="btn btn-sm btn-dark">
                                        Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Map -->
        <div class="mb-5 mt-4">
            <h4>Where you'll be</h4>
            <div id="map"></div>
        </div>
    </div>

</div>

<script src="/js/map.js"></script>