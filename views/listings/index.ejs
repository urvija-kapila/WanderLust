
<% layout("/layouts/boilerplate") %>

<body class="plus-jakarta-sans-text"></body>

<style>
/* ===================================
   MAIN FILTER BAR
=================================== */
#filters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.5rem;
    width: 100%;
    min-width: 0;
    margin-bottom: 1.5rem;
}

.filter-container {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    gap: 0.5rem;
}

.filter-scroll {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    flex: 1 1 0;
    min-width: 0;
}

/* Hide scrollbar in Chrome */
.filter-scroll::-webkit-scrollbar {
    display: none;
}

/* ===================================
   INDIVIDUAL FILTERS
=================================== */

.filter {
    text-align: center;
    opacity: 0.7;
    text-decoration: none;
    color: #222222;
    padding: 0.5rem;
    flex-shrink: 0;
    white-space: nowrap;
}

.filter:hover {
    opacity: 1;
    color: #222222;
}

.filter i {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
}

.filter p {
    font-size: 0.7rem;
    margin-bottom: 0;
}

/* Active category */
.filter.active {
    opacity: 1;
    border-bottom: 2px solid #fe424d;
    color: #fe424d;
}
/* ===================================
   ARROW BUTTONS
=================================== */
.scroll-btn {
    border: 1px solid #b0b0b0;
    border-radius: 50%;
    background: white;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.scroll-btn:hover {
    background: #f1f1f1;
}

.scroll-btn:disabled {
    opacity: 0.3;
    cursor: default;
}

/* ===================================
   TAX TOGGLE
=================================== */

.tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 0;
    white-space: nowrap;
}

/* Full label on desktop and laptop */
.tax-label-full {
    display: inline;
}

/* Short label hidden by default */
.tax-label-short {
    display: none;
}

.tax-info {
    display: none;
}

/* ===================================
   TABLET AND MOBILE
   Below 992px
=================================== */

@media (max-width: 991.98px) {

    #filters {
        flex-wrap: nowrap;
        gap: 0.75rem;
    }

    .filter-container {
        flex: 1 1 0;
        min-width: 0;
    }

    .filter-scroll {
        min-width: 0;
        gap: 1.5rem;
    }

    .tax-label-full {
        display: none;
    }

    .tax-label-short {
        display: inline;
    }

    .tax-toggle {
        flex-shrink: 0;
        padding: 1rem;
    }
}

/* ===================================
   SMALL MOBILE SCREENS
   Below 576px
=================================== */

@media (max-width: 575.98px) {

    #filters {
        gap: 0.5rem;
    }

    .filter-container {
        flex: 1 1 0;
        min-width: 0;
        gap: 0.5rem;
    }

    .filter-scroll {
        min-width: 0;
        gap: 1.5rem;
    }

    /* Keep original icon sizes and spacing */
    .filter {
        flex-shrink: 0;
    }

    /* Keep arrow button dimensions unchanged */
    .scroll-btn {
        flex-shrink: 0;
    }

    /* Compact tax toggle only on small screens */
    .tax-toggle {
        padding: 0.65rem;
        flex-shrink: 0;
    }
}

</style>

<!-- Main Filter Bar -->
<div id="filters">
    <!-- Scrollable Filters Section -->
    <div class="filter-container">
        
        <button type="button" class="scroll-btn" id="scrollLeft" aria-label="Scroll filters left">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        
        <div class="filter-scroll" id="filterScroll">
            <!-- All Filter -->
            <a href="/listings" class="filter <%= !selectedCategory ? 'active' : '' %>">
                <div>
                    <i class="fa-solid fa-border-all"></i>
                </div>
                <p>All</p>
            </a>
            <!-- Dynamic Category Filters -->
            <% categories.forEach(category => { %>
                <a href="/listings?category=<%= encodeURIComponent(category.name) %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
                    class="filter <%= selectedCategory === category.name ? 'active' : '' %>">
                    <div>
                        <i class="<%= category.icon %>"></i>
                    </div>
                    <p><%= category.name %></p>
                </a>
            <% }); %>
            
        </div>
        
        <button type="button" class="scroll-btn" id="scrollRight" aria-label="Scroll filters right">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
    
    <div class="tax-toggle">
        <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="customSwitch1">
            <label class="custom-control-label" for="customSwitch1">
                <span class="tax-label-full">Display total after taxes</span>
                <span class="tax-label-short">Taxes</span>
            </label>
        </div>
    </div>
</div>


<!-- Search Results Heading -->
<% if (searchQuery) { %>
    <div class="mb-4">
        <h4>
            Search results for "<%= searchQuery %>"
        </h4>
        <p class="text-muted">
            <%= allListings.length %>
            <%= allListings.length === 1 ? "property" : "properties" %>
            found
            <% if (selectedCategory) { %>
                in <%= selectedCategory %>
            <% } %>
        </p>
        <a href="/listings" class="btn btn-outline-dark btn-sm">
            <i class="fa-solid fa-xmark"></i>
            Clear Search
        </a>
    </div>

<% } else if (selectedCategory) { %>
    <h4 class="mb-3">
        <%= selectedCategory %> Properties
    </h4>
<% } %>


<!-- Show message when no properties match -->
<% if (allListings.length === 0) { %>
    <div class="text-center mt-5">
        <h4>No properties found!</h4>
        <% if (searchQuery) { %>
            <p> No listings found matching "<%= searchQuery %>".</p>
            <p>Try searching with a different keyword.</p>
        <% } else { %>
            <p>There are currently no listings available in this category.</p>
        <% } %>

        <a href="/listings" class="btn btn-dark"> View All Listings</a>

    </div>

<% } else { %>
    <!-- Existing Listing Cards -->
    <div class="row mt-3">
        <% for (let listing of allListings) { %>
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card w-100">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 15rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b>
                                <br>
                                &#8377; <%= listing.price.toLocaleString("en-IN") %> for 1 night
                                <i class="tax-info">
                                    &nbsp; +18% GST
                                </i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<!-- Existing Tax Toggle Functionality -->
<script>
    const taxSwitch = document.getElementById("customSwitch1");
    taxSwitch.addEventListener("change", () => {
        const taxInfo = document.getElementsByClassName("tax-info");
        for (const info of taxInfo) {
            info.style.display = taxSwitch.checked? "inline": "none";
        }
    });
</script>

<script>
    const filterScroll =document.getElementById("filterScroll");
    const scrollLeftBtn =document.getElementById("scrollLeft");
    const scrollRightBtn =document.getElementById("scrollRight");

    // Scroll left
    scrollLeftBtn.addEventListener("click", () => {
        filterScroll.scrollBy({
            left: -250,
            behavior: "smooth"
        });
    });

    // Scroll right
    scrollRightBtn.addEventListener("click", () => {
        filterScroll.scrollBy({
            left: 250,
            behavior: "smooth"
        });
    });

    // Disable arrows when scrolling reaches the ends
    function updateScrollButtons() {
        const maxScroll =
            filterScroll.scrollWidth - filterScroll.clientWidth;

        scrollLeftBtn.disabled = filterScroll.scrollLeft <= 1;

        scrollRightBtn.disabled =
            filterScroll.scrollLeft >= maxScroll - 1;
    }

    filterScroll.addEventListener("scroll", updateScrollButtons);
    window.addEventListener("resize", updateScrollButtons);

    updateScrollButtons();

    // Keep the selected filter visible after page reload
    const activeFilter =
        filterScroll.querySelector(".filter.active");

    if (activeFilter) {
        const targetScroll =
            activeFilter.offsetLeft -
            filterScroll.offsetLeft -
            filterScroll.clientWidth / 2 +
            activeFilter.clientWidth / 2;

        filterScroll.scrollLeft = targetScroll;
        updateScrollButtons();
    }
</script>