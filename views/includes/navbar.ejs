<style>
  .btn-search {
    background-color: #fe424d;
    color: white;
    border: none;
  }
  .btn-search:hover {
    background-color: #e63946;
    color: white;
  }
</style>

<nav class="navbar navbar-expand-lg navbar-light bg-light wanderlust-navbar">
  <a class="navbar-brand" href="/listings">
    <i class="fa-regular fa-compass"></i>
  </a>

  <!-- Mobile Hamburger Button -->
  <button
    class="navbar-toggler"
    type="button"
    data-toggle="collapse"
    data-target="#navbarNavAltMarkup"
    aria-controls="navbarNavAltMarkup"
    aria-expanded="false"
    aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <!-- Collapsible Navbar Content -->
  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
    <div class="navbar-nav">
      <a class="nav-item nav-link" href="/listings">
        Explore
      </a>
    </div>
    <form class="navbar-search" action="/listings" method="GET">
      <input
        class="form-control"
        type="search"
        name="search"
        placeholder="Search destinations or properties"
        aria-label="Search"
        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
      >
      <% if (typeof selectedCategory !== 'undefined' && selectedCategory) { %>
        <input
            type="hidden"
            name="category"
            value="<%= selectedCategory %>"
        >
      <% } %>
      <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search
      </button>
    </form>

    <div class="navbar-nav navbar-right-links">
      <a class="nav-item nav-link" href="/listings/new">
        List your place
      </a>
      <% if (!currUser) { %>
        <a class="nav-item nav-link" href="/signup">
          <b>Sign up</b>
        </a>
        <a class="nav-item nav-link" href="/login">
          <b>Login</b>
        </a>
      <% } else { %>
          <a class="nav-item nav-link" href="/logout">
              Logout
          </a>
      <% } %>
    </div>
  </div>
</nav>
