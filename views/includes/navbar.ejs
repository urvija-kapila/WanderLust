<style>
  .btn-search{
    background-color: #fe424d;
    color: #fff;
  }
</style>

<nav class="navbar navbar-expand-md navbar-light bg-light" border-bottom sticky-top>
  <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
    <div class="navbar-nav">
      <a class="nav-item nav-link" href="/listings">Explore</a>
    </div>
    <div class="navbar-nav ml-auto mt-4">
      <nav class="navbar navbar-light bg-light">
        <form class="form-inline" action="/listings" method="GET">
            <input
                class="form-control mr-sm-2"
                type="search"
                name="search"
                placeholder="Search destinations or properties"
                aria-label="Search"
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            >
            <% if (typeof selectedCategory !== 'undefined' && selectedCategory) { %>
                <input
                    type="hidden"
                    name="category"
                    value="<%= selectedCategory %>"
                >
            <% } %>
            <button class="btn btn-search my-2 my-sm-0" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>Search
            </button>
        </form>
      </nav>
    </div>
    
    <div class="navbar-nav ml-auto">
      <a class="nav-item nav-link" href="/listings/new">List your place</a>
      <% if(!currUser) { %>
      <a class="nav-item nav-link active" href="/signup"><b> Sign up</b> </a>
      <a class="nav-item nav-link" href="/login"><b>Login</b></a>
      <% } %> 
      <% if(currUser) { %>
      <a class="nav-item nav-link" href="/logout">Logout</a>
      <% } %>
    </div>
  </div>
</nav>